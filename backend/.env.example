# Runtime mode: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed CORS origin(s), comma-separated, each exactly like https://app.example.com (no
# trailing slash). Required when NODE_ENV=production, where * is refused. Unset or * allows any
# origin, for local development only. (The Android app sends no Origin and is not affected)
CORS_ORIGIN=*

# Postgres connection string (Neon, with PostGIS). Used by the app and by `npm run migrate`.
# In production, Neon's pooled URL (host contains -pooler)
DATABASE_URL=postgresql://user:password@host/campuspool?sslmode=require

# Optional direct (non-pooled) URL, used only by `npm run migrate:deploy` (Render's start command
# runs it): migrations need a direct connection. Unset: migrations use DATABASE_URL
DIRECT_URL=

# The test database is configured in .env.test (copy .env.test.example), which points at the
# local Docker database. Tests ignore this value; it only records the Neon test branch URL so you
# can swap it in (see README "Running against the Neon test branch")
TEST_DATABASE_URL=postgresql://user:password@host/campuspool_test?sslmode=require

# Secret used to sign access tokens (JWT) and to hash email OTP codes. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Only emails at this domain can sign up (exact domain, no @). The app defaults to nsut.ac.in;
# if you change this, build the app with --dart-define=ALLOWED_EMAIL_DOMAIN=<the same domain>
ALLOWED_EMAIL_DOMAIN=nsut.ac.in

# How OTP emails are sent: smtp (Nodemailer, for local development, e.g. Gmail SMTP) or brevo
# (Brevo's HTTP API, used on Render, whose free plan blocks outbound SMTP)
EMAIL_PROVIDER=smtp

# SMTP server, required when EMAIL_PROVIDER=smtp (any free SMTP provider works)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Brevo API key (SMTP & API -> API Keys), required when EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# Sender of OTP emails, like "CampusPool <sender@example.com>". Required in production; with
# Brevo it must be a verified sender. Default outside production: CampusPool <no-reply@campuspool.local>
MAIL_FROM=CampusPool <no-reply@example.com>

# OSRM server used to compute driving routes (no API key). Optional; defaults to the public
# demo server https://router.project-osrm.org, which is rate-limited and for light use only
ROUTING_BASE_URL=https://router.project-osrm.org

# Absolute path to the Firebase service account JSON used to send push notifications (FCM).
# Keep the file outside the repo and never commit it. Required in production (on Render, a Secret
# File under /etc/secrets/). Elsewhere, leave empty to skip sending (logged once)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Production only: proxies in front of the API, for the client IP the rate limits use. Default 1.
# Check it after a deploy with DEBUG_CLIENT_IP (docs/deploy-render.md)
TRUST_PROXY_HOPS=

# 1 turns on GET /debug/client-ip (your own IP as the API sees it). Off by default; turn it off
# right after checking
DEBUG_CLIENT_IP=
