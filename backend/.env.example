# Runtime mode: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed CORS origin(s), comma-separated. Use * only for local development
CORS_ORIGIN=*

# Postgres connection string (Neon, with PostGIS). Used by the app and by `npm run migrate`
DATABASE_URL=postgresql://user:password@host/campuspool?sslmode=require

# Separate Postgres database used ONLY by Jest. During tests it replaces DATABASE_URL,
# so tests never touch the dev database. Must be a different database/branch from DATABASE_URL
TEST_DATABASE_URL=postgresql://user:password@host/campuspool_test?sslmode=require
