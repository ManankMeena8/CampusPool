# Runtime mode: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed CORS origin(s), comma-separated. Use * only for local development
CORS_ORIGIN=*

# Postgres connection string (Neon, with PostGIS). Used by the app and by `npm run migrate`
DATABASE_URL=postgresql://user:password@host/campuspool?sslmode=require

# The test database is configured in .env.test (copy .env.test.example), which points at the
# local Docker database. Tests ignore this value; it only records the Neon test branch URL so you
# can swap it in (see README "Running against the Neon test branch")
TEST_DATABASE_URL=postgresql://user:password@host/campuspool_test?sslmode=require

# Secret used to sign access tokens (JWT) and to hash email OTP codes. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Only emails at this domain can sign up (exact domain, no @)
ALLOWED_EMAIL_DOMAIN=college.edu

# SMTP server used by Nodemailer to send OTP emails (any free SMTP provider works)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusPool <no-reply@example.com>

# OSRM server used to compute driving routes (no API key). Optional; defaults to the public
# demo server https://router.project-osrm.org, which is rate-limited and for light use only
ROUTING_BASE_URL=https://router.project-osrm.org
