# Test-only settings, loaded by tests/setup.js before .env (shell variables still win).
# Copy to .env.test. Start the database with: npm run db:test:up
DATABASE_URL=postgresql://campuspool:campuspool@localhost:5433/campuspool_test
TEST_DATABASE_URL=postgresql://campuspool:campuspool@localhost:5433/campuspool_test

# To run against a remote test database (e.g. the Neon test branch) instead, set
# TEST_DATABASE_URL to it and ALLOW_REMOTE_TEST_DB=1. The guard in tests/setup.js
# refuses any remote URL without this flag, and always refuses the dev DATABASE_URL.
# ALLOW_REMOTE_TEST_DB=1
