generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  BOTH
}

enum OtpPurpose {
  SIGNUP
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(RIDER)
  isVerified   Boolean  @default(false)
  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  rides         Ride[]
}

model EmailOtp {
  id         String     @id @default(uuid())
  email      String
  codeHash   String
  purpose    OtpPurpose @default(SIGNUP)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RideStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Ride {
  id              String                                      @id @default(uuid())
  driverId        String
  startAddress    String
  endAddress      String
  startPoint      Unsupported("geography(Point, 4326)")
  endPoint        Unsupported("geography(Point, 4326)")
  routeLine       Unsupported("geography(LineString, 4326)")?
  distanceMeters  Int?
  durationSeconds Int?
  departureTime   DateTime
  seatsTotal      Int
  seatsAvailable  Int
  pricePerSeat    Int                                         @default(0)
  notes           String?
  status          RideStatus                                  @default(OPEN)
  createdAt       DateTime                                    @default(now())
  updatedAt       DateTime                                    @updatedAt

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, departureTime])
  @@index([status, departureTime])
  @@index([startPoint], type: Gist)
  @@index([endPoint], type: Gist)
  @@index([routeLine], type: Gist)
}
